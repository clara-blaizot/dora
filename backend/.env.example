# Copier ce fichier en `.env` (jamais commité) et renseigner la clé.
GEMINI_API_KEY=colle_ta_clé_gemini_ici

# Modèle gémini utilisé pour rédiger les réponses
DORA_MODEL=gemini-3.8-flash

# Origine du frontend autorisée (CORS)
FRONTEND_ORIGIN=http://localhost:5173

# --- RAG ---
# Modèle d'embeddings (local, via fastembed). En changer impose de réindexer.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Laisser vide pour un Qdrant local (backend/data/qdrant), sinon ex. http://localhost:6333
QDRANT_URL=
QDRANT_COLLECTION=cours
# Nombre de passages récupérés par question
RAG_TOP_K=5
